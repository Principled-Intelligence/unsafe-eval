# Optional: required when selecting an OpenAI model.
OPENAI_API_KEY=

# Optional: required when selecting an Anthropic model.
ANTHROPIC_API_KEY=

# Optional: required when selecting a Google model.
GOOGLE_API_KEY=

# Optional: required when selecting an OpenRouter model.
OPENROUTER_API_KEY=

# Optional: required when selecting a TypeSafe model, such as the `jev` protocol's
# `typesafe/jev-1.13.0`. Needs the `typesafe` extra.
TYPESAFE_API_KEY=

# Optional: required only for gated Hugging Face Hub repositories.
HF_TOKEN=

# Optional: use a non-default Hugging Face cache location.
HF_HOME=

# Optional: connect Inspect to an already-running vLLM server.
# A remote vLLM server needs only the `openai` extra, not the `vllm` extra.
VLLM_BASE_URL=
VLLM_API_KEY=
